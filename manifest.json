{
  "schemaVersion": 1,
  "id": "yasserdo.awqat",
  "name": "Awqat · أوقات",
  "version": "1.2.2",
  "author": "Yasser",
  "license": "MIT",
  "description": "A simple, lightweight Rust-powered prayer-times plugin with automatic location, countdowns, custom bar formats, notifications, and adhan.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Awqat",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "barPreset": "name-time",
      "barFormat": "{name} {h}::{mm}:{ampm}",
      "showIcon": true,
      "notifications": false,
      "sound": "none",
      "volume": 35,
      "locationMode": "auto",
      "city": "Riyadh",
      "method": "auto",
      "school": "0",
      "clock24": false
    }
  }
}
